NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# PostgreSQL connection.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/qr_menu_dev?schema=public"

# Generate a unique secret with: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
