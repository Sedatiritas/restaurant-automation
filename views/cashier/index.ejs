<%- include("../partials/head.ejs", {
  title: "Kasa | Roast & Co.",
  description: "Roast & Co. masa adisyonlarını görüntüleme",
  themeColor: "#f7f5f0",
  viewport: "width=device-width, initial-scale=1",
  cssFile: "cashier.css"
}) %>

<div class="cashier-app">
    <header class="cashier-topbar">
      <a class="cashier-brand" href="/cashier" aria-label="Kasa ana sayfa">
        <span class="brand-mark"><i class="bi bi-cash-stack"></i></span>
        <span><strong id="cashierBrandName">roast &amp; co.</strong><small>KASA</small></span>
      </a>
      <div class="topbar-actions">
        <span class="connection-status" id="connectionStatus"><span class="status-dot"></span><span>Bağlanıyor</span></span>
        <span class="cashier-current-user"><%= authUser.username %></span>
        <form action="/auth/logout" method="post"><button class="btn btn-sm btn-outline-secondary" type="submit"><i class="bi bi-box-arrow-right me-1"></i>Çıkış</button></form>
      </div>
    </header>

    <main class="cashier-main">
      <section class="page-heading">
        <div>
          <span class="eyebrow">ADİSYON TAKİBİ</span>
          <h1>Kasa</h1>
          <p>Masayı seç, siparişleri ve ürün tutarlarını görüntüle.</p>
        </div>
        <button class="refresh-button" id="refreshButton" type="button"><i class="bi bi-arrow-clockwise"></i><span>Yenile</span></button>
      </section>

      <div class="api-notice" id="apiNotice" hidden role="status">
        <i class="bi bi-info-circle"></i>
        <div><strong>Kasa servisi henüz bağlanmadı.</strong><span>Bu ekran açık adisyonları ve toplam ücretleri API üzerinden görüntüleyecek.</span></div>
      </div>

      <section class="metrics-grid" aria-label="Kasa özeti">
        <article class="metric-card">
          <span class="metric-icon"><i class="bi bi-receipt"></i></span>
          <span class="metric-copy"><small>Açık hesap</small><strong id="openBillCount">—</strong></span>
        </article>
        <article class="metric-card">
          <span class="metric-icon metric-icon-warm"><i class="bi bi-wallet2"></i></span>
          <span class="metric-copy"><small>Açık hesap toplamı</small><strong id="openBillTotal">—</strong></span>
        </article>
        <article class="metric-card">
          <span class="metric-icon metric-icon-green"><i class="bi bi-grid-3x3-gap"></i></span>
          <span class="metric-copy"><small>Hesabı açık masa</small><strong id="openTableCount">—</strong></span>
        </article>
      </section>

      <section class="cashier-layout">
        <section class="panel table-panel" aria-label="Açık adisyonlar">
          <div class="panel-heading">
            <div><span class="eyebrow">MASA SEÇİMİ</span><h2>Masalar</h2><p>Detaylarını görmek için masa seç.</p></div>
            <span class="count-pill" id="tableResultCount">Yükleniyor</span>
          </div>
          <div class="table-tools">
            <label class="search-control"><i class="bi bi-search"></i><input id="tableSearch" type="search" placeholder="Masa ara..." autocomplete="off" aria-label="Masa ara"></label>
            <div class="filter-pills" role="group" aria-label="Masa filtresi">
              <button type="button" class="filter-pill active" data-filter="open">Açık adisyonlar</button>
              <button type="button" class="filter-pill" data-filter="all">Tüm masalar</button>
            </div>
          </div>
          <div class="bill-table-list" id="billTableList" aria-live="polite">
            <div class="list-placeholder"><span class="placeholder-icon"><i class="bi bi-arrow-repeat"></i></span><strong>Adisyonlar yükleniyor</strong><span>Garsonlardan gelen siparişler sunucudan alınıyor.</span></div>
          </div>
        </section>

        <section class="panel bill-detail-panel" aria-label="Seçili masa hesabı">
          <div class="panel-heading detail-panel-heading">
            <div><span class="eyebrow">SEÇİLİ MASA</span><h2 id="selectedTableName">Masa seçilmedi</h2><p id="selectedTableMeta">Açık adisyonu olan bir masa seç.</p></div>
            <span class="bill-status" id="selectedBillStatus">Bekliyor</span>
          </div>
          <div class="bill-detail-body" id="billDetailBody">
            <div class="detail-placeholder"><span class="placeholder-icon"><i class="bi bi-receipt"></i></span><strong>Adisyon bekleniyor</strong><span>Garson yeni sipariş gönderdiğinde ürünler burada listelenecek.</span></div>
          </div>
          <div class="bill-total-panel">
            <div class="bill-payment-summary">
              <div><span>Adisyon toplamı</span><strong id="billGrandTotal">₺0,00</strong></div>
              <div><span>Tahsil edilen</span><strong id="paidTotal">₺0,00</strong></div>
              <div><span>Kalan tutar</span><strong id="remainingTotal">₺0,00</strong></div>
            </div>
            <div class="bill-total-row"><span>Seçilenlerin tahsilat tutarı</span><strong id="billTotal">₺0,00</strong></div>
            <p class="close-bill-note" id="closeBillNote">Ödenmemiş ürünleri seçerek tahsilat oluştur. Adisyonu ayrıca kapatacaksın.</p>
            <fieldset class="payment-method-picker">
              <legend>Ödeme türü</legend>
              <div class="payment-method-options">
                <label class="payment-method-option is-selected" for="paymentCash">
                  <input id="paymentCash" type="radio" name="paymentMethod" value="cash" checked>
                  <span class="payment-method-icon"><i class="bi bi-cash-coin"></i></span>
                  <span class="payment-method-copy"><strong>Nakit</strong><small>Nakit tahsilat</small></span>
                </label>
                <label class="payment-method-option" for="paymentCard">
                  <input id="paymentCard" type="radio" name="paymentMethod" value="card">
                  <span class="payment-method-icon"><i class="bi bi-credit-card"></i></span>
                  <span class="payment-method-copy"><strong>Kart</strong><small>Kart tahsilatı</small></span>
                </label>
              </div>
              <small class="payment-method-note">Ödeme türü kaydedilir; bu ekran karttan otomatik para çekmez.</small>
            </fieldset>
            <button class="collect-payment-button" id="collectSelectedButton" type="button" disabled>
              <i class="bi bi-wallet2"></i><span>Seçilenleri Tahsil Et</span>
            </button>
            <button class="close-bill-button" id="closeBillButton" type="button" disabled>
              <i class="bi bi-check2-circle"></i><span>Adisyonu Kapat</span>
            </button>
          </div>
        </section>
      </section>
    </main>
  </div>

  <div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="cashierToast" class="toast border-0" role="status" aria-live="polite" aria-atomic="true">
      <div class="d-flex"><div class="toast-body" id="cashierToastMessage"></div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Kapat"></button></div>
    </div>
  </div>
  
  

<%- include("../partials/scripts.ejs", { pageScript: "cashier.js" }) %>
