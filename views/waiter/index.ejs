<%- include("../partials/head.ejs", {
  title: "Garson Paneli | Roast & Co.",
  description: "Roast & Co. garson menü görüntüleme paneli",
  themeColor: "#f7f5f0",
  viewport: "width=device-width, initial-scale=1, viewport-fit=cover",
  cssFile: "waiter.css"
}) %>

<div class="waiter-app">
  <header class="waiter-topbar">
    <a class="waiter-brand" href="/waiter" aria-label="Garson menüsüne dön">
      <span class="brand-mark"><i class="bi bi-cup-hot-fill"></i></span>
      <span><strong id="waiterBrandName">roast &amp; co.</strong><small>GARSON PANELİ</small></span>
    </a>
    <div class="topbar-right">
      <span class="service-status" id="serviceStatus"><span class="status-dot"></span><span id="serviceStatusText">Servis açık</span></span>
      <span class="waiter-current-user"><%= authUser.username %></span>
      <form action="/auth/logout" method="post"><button class="btn btn-sm btn-outline-secondary" type="submit"><i class="bi bi-box-arrow-right me-1"></i>Çıkış</button></form>
    </div>
  </header>

  <main class="waiter-main">
    <section class="page-intro">
      <div class="intro-copy">
        <span class="eyebrow">SALON YÖNETİMİ</span>
        <h1>Masa ve Menü</h1>
        <p>Çalışacağınız masayı seçin; ardından menü kategorilerini ve ürünlerini görüntüleyin.</p>
      </div>
      <div class="shift-summary">
        <span class="shift-icon"><i class="bi bi-grid-1x2-fill"></i></span>
        <span><strong id="tableCountSummary">Masalar yükleniyor</strong><small id="tableSelectionSummary">Henüz masa seçilmedi</small></span>
      </div>
    </section>

    <section class="view-screen mb-4" aria-label="Garson masaları">
      <div class="catalog-heading">
        <div>
          <span class="eyebrow">SALON</span>
          <h2>Masalar</h2>
          <p>Masayı seçerek aktif çalışma alanını belirleyin.</p>
        </div>
        <label class="table-search">
          <i class="bi bi-search" aria-hidden="true"></i>
          <input type="search" id="tableSearch" placeholder="Masa ara..." autocomplete="off" aria-label="Masa ara">
        </label>
      </div>
      <div class="table-grid" id="tablesGrid" aria-live="polite">
        <div class="empty-history"><strong>Masalar yükleniyor</strong><span>Masa listesi sunucudan alınıyor.</span></div>
      </div>
      <div class="page-footnote"><i class="bi bi-info-circle"></i><span>Şimdilik masaları ve menü ürünlerini görüntüleyebilirsiniz. Sipariş oluşturma ve kasaya gönderme henüz etkin değil.</span></div>
    </section>

    <section class="catalog-section" aria-label="Menü ürünleri">
      <div class="catalog-heading">
        <div>
          <span class="eyebrow">MENÜ LİSTESİ</span>
          <h2>Menüdeki ürünler</h2>
          <p>Ürün bilgileri ve güncel fiyatlar.</p>
        </div>
        <label class="product-search">
          <i class="bi bi-search" aria-hidden="true"></i>
          <input type="search" id="productSearch" placeholder="Ürün ara..." autocomplete="off" aria-label="Ürün ara">
        </label>
      </div>
      <nav class="category-tabs" id="categoryTabs" aria-label="Ürün kategorileri"></nav>
      <div class="catalog-meta">
        <span id="productsResultCount">Menü yükleniyor...</span>
        <span>Fiyatlar TL</span>
      </div>
      <div class="product-grid" id="productGrid" aria-live="polite"></div>
      <div class="catalog-empty" id="catalogEmpty" hidden>
        <i class="bi bi-cup-hot"></i>
        <strong>Henüz gösterilecek ürün yok</strong>
        <span>Yönetici ürün ve kategori eklediğinde burada görünecek.</span>
      </div>
    </section>
  </main>
</div>

<%- include("../partials/scripts.ejs", { pageScript: "waiter.js" }) %>
