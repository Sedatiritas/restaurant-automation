<%- include("../partials/head.ejs", {
  title: "Garson Paneli | Roast & Co.",
  description: "Roast & Co. garson masa ve menü görüntüleme paneli",
  themeColor: "#f7f5f0",
  viewport: "width=device-width, initial-scale=1, viewport-fit=cover",
  cssFile: "waiter.css"
}) %>

<div class="waiter-app">
  <header class="waiter-topbar">
    <a class="waiter-brand" href="/waiter" aria-label="Masa listesine dön">
      <span class="brand-mark"><i class="bi bi-cup-hot-fill"></i></span>
      <span><strong id="waiterBrandName">roast &amp; co.</strong><small>GARSON PANELİ</small></span>
    </a>
    <div class="topbar-right">
      <span class="service-status" id="serviceStatus"><span class="status-dot"></span><span id="serviceStatusText">Servis açık</span></span>
      <span class="waiter-current-user"><%= authUser.username %></span>
      <form action="/auth/logout" method="post">
        <button class="btn btn-sm btn-outline-secondary" type="submit"><i class="bi bi-box-arrow-right me-1"></i>Çıkış</button>
      </form>
    </div>
  </header>

  <main class="waiter-main">
    <section class="page-intro">
      <div class="intro-copy">
        <span class="eyebrow" id="viewEyebrow">SALON YÖNETİMİ</span>
        <h1 id="viewTitle">Masalarım</h1>
        <p id="viewDescription">Çalışacağınız masayı seçin; menü kategorileri ve ürünleri görüntüleyin.</p>
      </div>
      <div class="shift-summary">
        <span class="shift-icon"><i class="bi bi-grid-1x2-fill"></i></span>
        <span><strong id="activeTableCount">Masalar yükleniyor</strong><small>Toplam masa</small></span>
      </div>
    </section>

    <section id="tablesView" class="view-screen" aria-label="Masa listesi">
      <div class="list-toolbar">
        <div class="filter-pills" role="group" aria-label="Masa listesi">
          <button class="filter-pill active" type="button">Tüm masalar <span id="allTableCount">0</span></button>
        </div>
        <label class="table-search">
          <i class="bi bi-search" aria-hidden="true"></i>
          <input type="search" id="tableSearch" placeholder="Masa ara..." autocomplete="off" aria-label="Masa ara">
        </label>
      </div>
      <div class="table-grid" id="tablesGrid" aria-live="polite">
        <div class="empty-history"><strong>Masalar yükleniyor</strong><span>Masa listesi sunucudan alınıyor.</span></div>
      </div>
      <div class="page-footnote">
        <i class="bi bi-info-circle"></i>
        <span>Menüyü görüntülemek için çalışacağınız masayı seçin. Sipariş oluşturma ve kasaya gönderme şu an devre dışıdır.</span>
      </div>
    </section>

    <section id="tableDetailsView" class="view-screen" hidden aria-label="Seçilen masa ve menü">
      <button class="back-link" id="backToTablesButton" type="button"><i class="bi bi-arrow-left"></i> Masalara dön</button>
      <div class="table-detail-hero surface-card">
        <div class="table-detail-title">
          <span class="table-hero-icon"><i class="bi bi-grid-1x2-fill"></i></span>
          <div>
            <span class="eyebrow">SEÇİLİ MASA</span>
            <h2 id="detailsTableName">Masa</h2>
            <p id="detailsTableMeta">Kişi kapasitesi</p>
          </div>
        </div>
        <span class="table-open-badge"><span class="status-dot"></span><span id="detailsTableStatus">Masa seçildi</span></span>
      </div>

      <section class="catalog-section mt-4" aria-label="Menü ürünleri">
        <div class="catalog-heading">
          <div>
            <span class="eyebrow">MENÜ</span>
            <h2>Ürün ve Kategoriler</h2>
            <p>Yönetici tarafından eklenen güncel ürünleri ve fiyatları görüntüleyin.</p>
          </div>
          <label class="product-search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" id="productSearch" placeholder="Ürün ara..." autocomplete="off" aria-label="Ürün ara">
          </label>
        </div>
        <nav class="category-tabs" id="categoryTabs" aria-label="Ürün kategorileri"></nav>
        <div class="catalog-meta">
          <span id="productsResultCount">Menü yükleniyor...</span>
          <span>Fiyatlar TL</span>
        </div>
        <div class="product-grid" id="productGrid" aria-live="polite"></div>
        <div class="catalog-empty" id="catalogEmpty" hidden></div>
      </section>
    </section>
  </main>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3">
  <div id="waiterToast" class="toast border-0" role="status" aria-live="polite" aria-atomic="true">
    <div class="d-flex">
      <div class="toast-body" id="waiterToastMessage"></div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Kapat"></button>
    </div>
  </div>
</div>

<%- include("../partials/scripts.ejs", { pageScript: "waiter.js" }) %>