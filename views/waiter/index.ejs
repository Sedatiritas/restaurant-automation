<%- include("../partials/head.ejs", {
  title: "Garson Paneli | Roast & Co.",
  description: "Roast & Co. garson masa ve menü yönetimi",
  themeColor: "#f7f5f0",
  viewport: "width=device-width, initial-scale=1, viewport-fit=cover",
  cssFile: "waiter.css"
}) %>

<div class="waiter-app">
  <header class="waiter-topbar">
    <a class="waiter-brand" href="/waiter" aria-label="Masa listesine dön">
      <span class="brand-mark"><i class="bi bi-cup-hot-fill"></i></span>
      <span><strong id="waiterBrandName">roast &amp; co.</strong><small>GARSON PANELİ</small></span>
    </a>
    <div class="topbar-right">
      <span class="service-status" id="serviceStatus"><span class="status-dot"></span><span id="serviceStatusText">Servis açık</span></span>
      <span class="waiter-current-user"><%= authUser.username %></span>
      <form action="/auth/logout" method="post">
        <button class="btn btn-sm btn-outline-secondary" type="submit"><i class="bi bi-box-arrow-right me-1"></i>Çıkış</button>
      </form>
    </div>
  </header>

  <main class="waiter-main">
    <section class="page-intro">
      <div class="intro-copy">
        <span class="eyebrow" id="viewEyebrow">SALON YÖNETİMİ</span>
        <h1 id="viewTitle">Masalarım</h1>
        <p id="viewDescription">Masa durumlarını, açık hesapları ve son siparişleri görüntüle.</p>
      </div>
      <div class="shift-summary">
        <span class="shift-icon"><i class="bi bi-receipt-cutoff"></i></span>
        <span><strong id="activeTableCount">0 masa</strong><small>Aktif adisyon</small></span>
      </div>
    </section>

    <section id="tablesView" class="view-screen" aria-label="Masa listesi">
      <div class="list-toolbar">
        <div class="filter-pills" role="group" aria-label="Masa filtreleri">
          <button class="filter-pill active" type="button" data-table-filter="all">Tüm masalar <span id="allTableCount">0</span></button>
          <button class="filter-pill" type="button" data-table-filter="active">Açık adisyonlar <span id="occupiedTableCount">0</span></button>
        </div>
        <label class="table-search">
          <i class="bi bi-search" aria-hidden="true"></i>
          <input type="search" id="tableSearch" placeholder="Masa ara..." autocomplete="off" aria-label="Masa ara">
        </label>
      </div>
      <div class="table-grid" id="tablesGrid" aria-live="polite">
        <div class="empty-history"><strong>Masalar yükleniyor</strong><span>Masa listesi sunucudan alınıyor.</span></div>
      </div>
      <div class="page-footnote">
        <i class="bi bi-info-circle"></i>
        <span>Masayı seçerek önceki siparişleri gör, yeni sipariş ekle veya adisyonu kontrol et.</span>
      </div>
    </section>

    <section id="tableDetailsView" class="view-screen" hidden aria-label="Seçilen masa">
      <button class="back-link" id="backToTablesButton" type="button"><i class="bi bi-arrow-left"></i> Masalara dön</button>
      <div class="table-detail-hero surface-card">
        <div class="table-detail-title">
          <span class="table-hero-icon"><i class="bi bi-grid-1x2-fill"></i></span>
          <div>
            <span class="eyebrow">MASA DETAYI</span>
            <h2 id="detailsTableName">Masa</h2>
            <p id="detailsTableMeta">Kişi kapasitesi</p>
          </div>
        </div>
        <span class="table-open-badge"><span class="status-dot"></span><span id="detailsTableStatus">Masa seçildi</span></span>
        <div class="table-summary-grid">
          <div class="summary-stat"><span>Adisyon sistemi</span><strong id="detailsGrandTotal">Henüz bağlı değil</strong></div>
          <div class="summary-stat"><span>Toplam ürün</span><strong id="detailsItemCount">0 adet</strong></div>
          <div class="summary-stat"><span>Sipariş geçmişi</span><strong id="detailsRoundCount">Henüz bağlı değil</strong></div>
        </div>
        <div class="table-detail-actions">
          <button class="btn-primary-action" id="startNewOrderButton" type="button"><i class="bi bi-plus-lg"></i> Yeni Sipariş Ekle</button>
        </div>
      </div>

      <section class="history-section">
        <div class="history-title-row">
          <div>
            <span class="eyebrow">ADİSYON KAYDI</span>
            <h2>Sipariş geçmişi</h2>
            <p>Sipariş ve adisyon backend'i henüz etkinleştirilmedi.</p>
          </div>
          <span class="history-count" id="historyCount">Henüz yok</span>
        </div>
        <div class="history-list" id="orderHistory" aria-live="polite"></div>
        <div id="historyEmpty" class="empty-history">
          <span class="empty-history-icon"><i class="bi bi-receipt"></i></span>
          <strong>Henüz bağlı bir sipariş kaydı yok</strong>
          <span>Bu aşamada masa ve menü bilgileri görüntülenebilir. Sipariş geçmişi sonraki backend aşamasında eklenecek.</span>
        </div>
      </section>
    </section>

    <section id="newOrderView" class="view-screen" hidden aria-label="Menü ve ürünler">
      <button class="back-link" id="backToDetailsButton" type="button"><i class="bi bi-arrow-left"></i> <span id="newOrderBackLabel">Masa detayına dön</span></button>
      <div class="new-order-heading">
        <div>
          <span class="eyebrow">YENİ SİPARİŞ</span>
          <h2 id="newOrderTableName">Masa 1 için sipariş</h2>
          <p>Ürünleri seç, kontrol et ve mutfağa gönder.</p>
        </div>
        <span class="round-chip" id="newOrderRoundLabel">Yeni tur</span>
      </div>

      <details class="order-summary-accordion surface-card" id="draftSummaryAccordion" open>
        <summary class="order-summary-trigger">
          <span class="order-summary-icon"><i class="bi bi-basket2"></i></span>
          <span class="order-summary-copy"><strong>Seçilen ürünler</strong><small id="draftItemCount">Henüz ürün seçilmedi</small></span>
          <strong class="order-summary-amount" id="draftTotal">₺0,00</strong>
          <span class="order-summary-chevron"><i class="bi bi-chevron-down"></i></span>
        </summary>
        <div class="order-summary-content">
          <div id="draftOrderItems" class="draft-order-items"></div>
          <div id="draftOrderEmpty" class="draft-order-empty"><i class="bi bi-basket2"></i><span>Menüden ürün ekledikçe burada geçici olarak görünecek.</span></div>
        </div>
      </details>

      <section class="catalog-section">
        <div class="catalog-heading">
          <div>
            <span class="eyebrow">MENÜ</span>
            <h2>Ürün ekle</h2>
            <p>Bir ürüne dokunarak siparişe ekle.</p>
          </div>
          <label class="product-search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" id="productSearch" placeholder="Ürün ara..." autocomplete="off" aria-label="Ürün ara">
          </label>
        </div>
        <nav class="category-tabs" id="categoryTabs" aria-label="Ürün kategorileri"></nav>
        <div class="catalog-meta"><span id="productsResultCount">Menü yükleniyor...</span><span>Fiyatlar TL</span></div>
        <div class="product-grid" id="productGrid" aria-live="polite"></div>
        <div class="catalog-empty" id="catalogEmpty" hidden></div>
      </section>

      <div class="send-order-bar">
        <div class="send-order-summary"><span id="sendOrderCount">0 ürün</span><strong id="sendOrderTotal">₺0,00</strong></div>
        <button class="send-order-button" id="sendOrderButton" type="button" disabled title="Sipariş kaydetme ve gönderme sonraki aşamada etkinleştirilecek.">
          <i class="bi bi-lock-fill"></i> Sipariş gönderimi kapalı
        </button>
      </div>
    </section>
  </main>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3">
  <div id="waiterToast" class="toast border-0" role="status" aria-live="polite" aria-atomic="true">
    <div class="d-flex">
      <div class="toast-body" id="waiterToastMessage"></div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Kapat"></button>
    </div>
  </div>
</div>

<%- include("../partials/scripts.ejs", { pageScript: "waiter.js" }) %>
