<%- include("../partials/head.ejs", {
  title: "Yönetim Paneli | Roast & Co.",
  description: "Roast & Co. QR menü yönetim paneli",
  themeColor: "#f7f5f0",
  viewport: "width=device-width, initial-scale=1",
  cssFile: "admin.css"
}) %>

<div class="admin-shell" data-current-user-id="<%= authUser.userId %>">
    <aside class="sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="adminSidebar" aria-label="Ana menü">
      <div class="sidebar-inner">
        <a class="admin-brand" href="#overview" data-view="overview">
          <span class="brand-mark"><i class="bi bi-cup-hot-fill"></i></span>
          <span><strong>roast &amp; co.</strong><small>MENÜ YÖNETİMİ</small></span>
          <button class="btn sidebar-close d-lg-none" type="button" data-bs-dismiss="offcanvas" aria-label="Menüyü kapat"><i class="bi bi-x-lg"></i></button>
        </a>
        <div class="sidebar-label">YÖNETİM</div>
        <nav class="admin-nav" aria-label="Yönetim ekranları">
          <a class="admin-nav-link active" href="#overview" data-view="overview"><i class="bi bi-grid-1x2"></i><span>Genel Bakış</span></a>
          <a class="admin-nav-link" href="#products" data-view="products"><i class="bi bi-cup-straw"></i><span>Ürünler</span></a>
          <a class="admin-nav-link" href="#categories" data-view="categories"><i class="bi bi-collection"></i><span>Kategoriler</span></a>
          <div class="sidebar-label sidebar-label-spaced">OPERASYON</div>
          <a class="admin-nav-link" href="/waiter"><i class="bi bi-receipt-cutoff"></i><span>Garson Siparişi</span><i class="bi bi-arrow-up-right ms-auto" aria-hidden="true"></i></a>
          <a class="admin-nav-link" href="#tables" data-view="tables"><i class="bi bi-grid-3x3-gap"></i><span>Masa Yönetimi</span></a>
          <a class="admin-nav-link" href="/cashier"><i class="bi bi-cash-stack"></i><span>Kasa</span><i class="bi bi-arrow-up-right ms-auto" aria-hidden="true"></i></a>
          <div class="sidebar-label sidebar-label-spaced">RAPORLAR</div>
          <a class="admin-nav-link" href="#revenue" data-view="revenue"><i class="bi bi-bar-chart-line"></i><span>Ciro Raporu</span></a>
          <div class="sidebar-label sidebar-label-spaced">İŞLETME</div>
          <a class="admin-nav-link" href="#appearance" data-view="appearance"><i class="bi bi-palette2"></i><span>Menü Görünümü</span></a>
          <a class="admin-nav-link" href="#settings" data-view="settings"><i class="bi bi-gear"></i><span>İşletme Ayarları</span></a>
          <a class="admin-nav-link" href="#staff" data-view="staff"><i class="bi bi-people"></i><span>Personel ve Yetkiler</span></a>
        </nav>
        <div class="sidebar-bottom">
          <div class="sidebar-user-wrap">
            <button class="sidebar-user" id="profileMenuButton" type="button" data-bs-toggle="dropdown" aria-expanded="false">
              <span class="user-avatar">RC</span><span><strong><%= authUser.username %></strong><small>Yönetici hesabı</small></span><i class="bi bi-three-dots ms-auto"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end profile-dropdown" aria-labelledby="profileMenuButton">
              <li><form action="/auth/logout" method="post"><button class="dropdown-item text-danger w-100 text-start" type="submit"><i class="bi bi-box-arrow-right me-2"></i>Çıkış yap</button></form></li>
            </ul>
          </div>
        </div>
      </div>
    </aside>

    <main class="main-area">
      <header class="topbar">
        <div class="topbar-start">
          <button class="btn icon-button d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" aria-controls="adminSidebar" aria-label="Menüyü aç"><i class="bi bi-list"></i></button>
          <div><div class="breadcrumb-label">YÖNETİM <span>/</span> <span id="breadcrumbCurrent">GENEL BAKIŞ</span></div><h1 id="pageTitle">Genel Bakış</h1></div>
        </div>
        <div class="topbar-actions">
          <a class="btn preview-button" href="/" target="_blank" rel="noopener noreferrer"><i class="bi bi-eye me-2"></i>Menüyü önizle</a>
          <button class="btn icon-button" id="notificationButton" type="button" aria-label="Bildirimler"><i class="bi bi-bell"></i></button>
        </div>
      </header>
      <div id="viewRoot" class="content-area" aria-live="polite"></div>
      <footer class="admin-footer"><span>© 2026 Roast &amp; Co. Yönetim Paneli</span><span>QR Menü Yönetimi</span></footer>
    </main>
  </div>

  <div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="adminToast" class="toast border-0" role="status" aria-live="polite" aria-atomic="true">
      <div class="d-flex"><div class="toast-body" id="adminToastMessage"></div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Kapat"></button></div>
    </div>
  </div>
  <div class="modal fade" id="appModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content" id="modalContent"></div></div></div>
  
  

<%- include("../partials/scripts.ejs", { pageScript: "admin.js" }) %>
