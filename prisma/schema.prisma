generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  WAITER
  CASHIER
}

enum ProductStatus {
  ACTIVE
  HIDDEN
  OUT_OF_STOCK
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  icon        String    @default("bi-collection")
  description String?   @db.VarChar(300)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([sortOrder, name])
  @@map("categories")
}

model Product {
  id          String        @id @default(uuid())
  name        String
  description String?       @db.VarChar(300)
  price       Decimal       @db.Decimal(10, 2)
  imageUrl    String?
  status      ProductStatus @default(ACTIVE)
  sortOrder   Int           @default(0)
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([categoryId, status, sortOrder])
  @@map("products")
}

model MenuAppearance {
  id              String   @id @default("default")
  brandName       String   @default("roast & co.") @db.VarChar(60)
  tagline         String   @default("COFFEE · DESSERT · MOMENTS") @db.VarChar(100)
  eyebrow         String   @default("HER FİNCANDA MUTLULUK") @db.VarChar(80)
  headline        String   @default("Kendine güzel bir mola ver.") @db.VarChar(140)
  logoUrl         String?
  coverUrl        String?
  accent          String   @default("#b96e43") @db.VarChar(7)
  isOpen          Boolean  @default(true)
  googleReviewUrl String?  @db.VarChar(1000)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("menu_appearance")
}

model BusinessSettings {
  id          String   @id @default("default")
  phone       String   @default("") @db.VarChar(40)
  email       String?  @db.VarChar(254)
  address     String?  @db.VarChar(500)
  description String   @default("Kahve, tatlı ve güzel anlar.") @db.VarChar(250)
  instagram   String?  @db.VarChar(1000)
  whatsapp    String?  @db.VarChar(1000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("business_settings")
}
