generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  WAITER
  CASHIER
}

enum ProductStatus {
  ACTIVE
  HIDDEN
  OUT_OF_STOCK
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  waiterOrders Order[]  @relation("WaiterOrders")
  cashierPayments Payment[] @relation("CashierPayments")

  @@map("users")
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  icon        String    @default("bi-collection")
  description String?   @db.VarChar(300)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([sortOrder, name])
  @@map("categories")
}

model Product {
  id          String        @id @default(uuid())
  name        String
  description String?       @db.VarChar(300)
  price       Decimal       @db.Decimal(10, 2)
  imageUrl    String?
  status      ProductStatus @default(ACTIVE)
  sortOrder   Int           @default(0)
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems  OrderItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([categoryId, status, sortOrder])
  @@map("products")
}

model DiningTable {
  id        String   @id @default(uuid())
  name      String   @unique @db.VarChar(60)
  seats     Int      @default(4)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bills     Bill[]

  @@index([sortOrder, name])
  @@map("restaurant_tables")
}

model MenuAppearance {
  id              String   @id @default("default")
  brandName       String   @default("roast & co.") @db.VarChar(60)
  tagline         String   @default("COFFEE · DESSERT · MOMENTS") @db.VarChar(100)
  eyebrow         String   @default("HER FİNCANDA MUTLULUK") @db.VarChar(80)
  headline        String   @default("Kendine güzel bir mola ver.") @db.VarChar(140)
  logoUrl         String?
  coverUrl        String?
  accent          String   @default("#b96e43") @db.VarChar(7)
  isOpen          Boolean  @default(true)
  googleReviewUrl String?  @db.VarChar(1000)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("menu_appearance")
}

model BusinessSettings {
  id          String   @id @default("default")
  phone       String   @default("") @db.VarChar(40)
  email       String?  @db.VarChar(254)
  address     String?  @db.VarChar(500)
  description String   @default("Kahve, tatlı ve güzel anlar.") @db.VarChar(250)
  instagram   String?  @db.VarChar(1000)
  whatsapp    String?  @db.VarChar(1000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("business_settings")
}

enum BillStatus {
  OPEN
  CLOSED
}

enum PaymentMethod {
  CASH
  CARD
}

model Bill {
  id            String     @id @default(uuid())
  tableId       String
  activeTableId String?    @unique
  status        BillStatus @default(OPEN)
  openedAt      DateTime   @default(now())
  closedAt      DateTime?
  table         DiningTable @relation(fields: [tableId], references: [id], onDelete: Restrict)
  orders        Order[]
  payments      Payment[]

  @@index([tableId, status])
  @@map("bills")
}

model Order {
  id          String      @id @default(uuid())
  billId      String
  waiterId    String
  roundNumber Int
  sentAt      DateTime    @default(now())
  bill        Bill        @relation(fields: [billId], references: [id], onDelete: Restrict)
  waiter      User        @relation("WaiterOrders", fields: [waiterId], references: [id], onDelete: Restrict)
  items       OrderItem[]

  @@unique([billId, roundNumber])
  @@index([billId, sentAt])
  @@map("orders")
}

model OrderItem {
  id          String     @id @default(uuid())
  orderId     String
  productId   String?
  productName String     @db.VarChar(100)
  unitPrice   Decimal    @db.Decimal(10, 2)
  quantity    Int
  createdAt   DateTime   @default(now())
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product     Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  allocations PaymentAllocation[]

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id        String        @id @default(uuid())
  billId    String
  cashierId String
  method    PaymentMethod
  amount    Decimal       @db.Decimal(10, 2)
  createdAt DateTime      @default(now())
  bill      Bill          @relation(fields: [billId], references: [id], onDelete: Restrict)
  cashier   User          @relation("CashierPayments", fields: [cashierId], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]

  @@index([billId, createdAt])
  @@map("payments")
}

model PaymentAllocation {
  id          String   @id @default(uuid())
  paymentId   String
  orderItemId String
  unitIndex   Int
  amount      Decimal  @db.Decimal(10, 2)
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, unitIndex])
  @@index([paymentId])
  @@map("payment_allocations")
}
